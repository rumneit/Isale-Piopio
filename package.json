    "@angular/compiler-cli": "22.2.1",
    "@angular/language-service": "22.2.1",
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "^0.5.12",
