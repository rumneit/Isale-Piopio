    "test:e2e": "node qa/e2e-smoke.mjs",
    "lint": "ng lint",
    "check:icons": "node check-icons.mjs",
    "test:ci": "ng test --configuration ci",
    "audit": "node audit.mjs",
    "verify:home": "node verify-home-button.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@capacitor/app": "8.1.1",
