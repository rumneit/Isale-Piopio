    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/angular": "^9.0.0",
    "@supabase/supabase-js": "2.116.0",
    "@types/jsbarcode": "^3.11.4",
    "handlebars": "^4.7.10",
    "ionicons": "^8.1.0",
    "jsbarcode": "^3.12.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
